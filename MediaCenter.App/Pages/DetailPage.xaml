<UserControl x:Class="MediaCenter.App.Pages.DetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MediaCenter.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="48,0,48,60">
            <Grid x:Name="HeroZone" MinHeight="440" Margin="0,76,0,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Titelbild als abgerundete Karte; Text und Knöpfe liegen darauf (dunkle Farben aus ThemeService.ArtTheme) -->
                <c:HeroArt x:Name="Art" Grid.RowSpan="2"/>
                <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" HorizontalAlignment="Left"
                        VerticalAlignment="Top" Margin="22,22,0,0" ToolTip="Zurück (Esc)"/>
                <Grid Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="52,0,0,44">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="680"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="PosterFrame" Width="240" Height="360" CornerRadius="14" ClipToBounds="True" VerticalAlignment="Bottom"
                            Margin="0,0,40,0" Visibility="Collapsed"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="Kicker" Style="{StaticResource KickerText}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TitleText" Style="{StaticResource DisplayText}" FontSize="76" TextWrapping="Wrap" LineHeight="68" LineStackingStrategy="BlockLineHeight"/>
                        <TextBlock x:Name="MetaText" Style="{StaticResource MutedText}" FontSize="14" Margin="0,8,0,0"/>
                        <TextBlock x:Name="PlotText" FontSize="15" LineHeight="23" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="CreditsText" Style="{StaticResource MutedText}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="SourceText" Style="{StaticResource FaintText}" FontSize="11" Margin="0,4,0,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="CollectionText" Style="{StaticResource MutedText}" FontSize="13" Margin="0,10,0,0" Visibility="Collapsed"/>
                        <WrapPanel x:Name="GenrePanel" Margin="0,16,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" Content="Abspielen"/>
                            <Button x:Name="ListButton" Style="{StaticResource GhostButton}" Margin="0,0,10,0" AutomationProperties.Name="Meine Liste"/>
                            <Button x:Name="WatchedButton" Style="{StaticResource GhostButton}" Margin="0,0,10,0" AutomationProperties.Name="Gesehen"/>
                            <Button x:Name="TrailerButton" Style="{StaticResource GhostButton}" Content="Trailer" Margin="0,0,10,0" Visibility="Collapsed" AutomationProperties.Name="Trailer"/>
                            <Button x:Name="EditButton" Style="{StaticResource GhostButton}" Content="Bearbeiten" Opacity="0.7" AutomationProperties.Name="Bearbeiten"/>
                            <TextBlock x:Name="OfflineText" Style="{StaticResource MutedText}" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <StackPanel x:Name="Episodes"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
