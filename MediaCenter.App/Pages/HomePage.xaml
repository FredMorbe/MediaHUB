<UserControl x:Class="MediaCenter.App.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MediaCenter.App.Controls">
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="48,0,48,60">
            <Grid x:Name="HeroZone" Height="440" Margin="0,76,0,28">
                <!-- Titelbild als abgerundete Karte; Text und Knöpfe liegen darauf (dunkle Farben aus ThemeService.ArtTheme) -->
                <c:HeroArt x:Name="Art"/>
                <Grid x:Name="HeroPanel" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="52,0,0,44" Width="600">
                    <StackPanel>
                        <TextBlock x:Name="Kicker" Style="{StaticResource KickerText}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="HeroTitle" Style="{StaticResource DisplayText}" FontSize="72" TextWrapping="Wrap" LineHeight="64" LineStackingStrategy="BlockLineHeight"/>
                        <TextBlock x:Name="HeroMeta" Style="{StaticResource MutedText}" FontSize="14" Margin="0,8,0,0"/>
                        <Border x:Name="HeroProgress" Visibility="Collapsed" Height="4" CornerRadius="2" Background="{DynamicResource LineBrush}" Margin="0,14,0,0" HorizontalAlignment="Left" Width="260">
                            <Border x:Name="HeroProgressFill" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource AccentBrush}"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                            <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" Content="Abspielen"/>
                            <Button x:Name="DetailsButton" Style="{StaticResource GhostButton}" Content="Details" Margin="10,0,0,0"/>
                            <Button x:Name="ChooseEpisodeButton" Style="{StaticResource GhostButton}" Content="Folge wählen" Margin="10,0,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Leere Bibliothek -->
                <Grid x:Name="EmptyPanel" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="52,0,0,44" Width="620">
                    <StackPanel>
                        <TextBlock Text="START" Style="{StaticResource KickerText}"/>
                        <TextBlock x:Name="EmptyTitle" Text="Noch nichts in der Bibliothek" Style="{StaticResource DisplayText}" FontSize="52" TextWrapping="Wrap"/>
                        <TextBlock x:Name="EmptyText" Style="{StaticResource MutedText}" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="Füge einen Ordner mit Filmen und Serien hinzu. Serien erkennt das Programm an Namen wie S01E03, alles Unklare landet in der Inbox."/>
                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                            <Button x:Name="AddFolderButton" Style="{StaticResource PrimaryButton}" Content="Ordner hinzufügen"/>
                            <Button x:Name="AddFileButton" Style="{StaticResource GhostButton}" Content="Datei hinzufügen" Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
            <StackPanel x:Name="Rows"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
