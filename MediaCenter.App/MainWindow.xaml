<Window x:Class="MediaCenter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:MediaCenter.App.Controls"
        xmlns:p="clr-namespace:MediaCenter.App.Player"
        Title="Mediacenter" Icon="pack://application:,,,/Assets/app.ico" Width="1500" Height="900" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}" FontFamily="{StaticResource BodyFont}"
        TextElement.Foreground="{DynamicResource InkBrush}" UseLayoutRounding="True">
    <Grid x:Name="Shell">

        <!-- Bühne: alles bis auf Rückfragen und Meldungen. Szene: Hintergrund und Seite. Das Milchglas liest von diesen beiden Ebenen
             (Navigation, Leiste und Modale von der Szene, Menüs, Rückfragen und Meldungen von der Bühne), damit nichts sich selbst weichzeichnet. -->
        <Grid x:Name="Stage">
        <Grid x:Name="Scene">

        <!-- Hintergrund: Grundfarbe, Farbschein in Akzentfarben, Titelbild mit Verlauf nach unten. Das Milchglas liest von hier. -->
        <Grid x:Name="Backdrop" IsHitTestVisible="False" ClipToBounds="True">
            <Rectangle Fill="{DynamicResource BgBrush}"/>
            <Grid x:Name="BackdropArt" VerticalAlignment="Top" Opacity="0">
                <Image x:Name="BackdropImage" Stretch="UniformToFill"/>
                <!-- Verlauf in die Grundfarbe statt OpacityMask: unten verschwindet das Bild ohne sichtbare Kante -->
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="{DynamicResource BgClearColor}" Offset="0.25"/>
                            <GradientStop Color="{DynamicResource BgColor}" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- Seiten: links dunkelt das Bild ab (dort steht der Text), rechts läuft es in die Grundfarbe aus -->
                <Rectangle Opacity="0.92">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource BgColor}" Offset="0"/>
                            <GradientStop Color="{DynamicResource BgClearColor}" Offset="0.62"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource BgClearColor}" Offset="0.78"/>
                            <GradientStop Color="{DynamicResource BgColor}" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.9,0.0" GradientOrigin="0.9,0.0" RadiusX="0.7" RadiusY="0.8">
                        <GradientStop Color="{DynamicResource AccentSoftColor}" Offset="0"/>
                        <GradientStop Color="{DynamicResource AccentClearColor}" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.0,1.0" GradientOrigin="0.0,1.0" RadiusX="0.6" RadiusY="0.7">
                        <GradientStop Color="{DynamicResource Accent2SoftColor}" Offset="0"/>
                        <GradientStop Color="{DynamicResource Accent2ClearColor}" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Height="360" VerticalAlignment="Top" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{DynamicResource BgColor}" Offset="0"/>
                        <GradientStop Color="{DynamicResource BgClearColor}" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <ContentPresenter x:Name="PageHost"/>
        </Grid>

        <!-- Navigation oben wie bei Netflix: Logo links bündig mit dem Inhalt, Reiter als Pillen, Symbole rechts -->
        <c:GlassPanel x:Name="Nav" Style="{StaticResource BarGlass}" VerticalAlignment="Top" Height="60" Padding="48,0,40,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Logo: das App-Symbol (K aus gefalteten Bändern, Assets\logo.png) statt der Wortmarke -->
                <Border x:Name="Logo" VerticalAlignment="Center" Background="Transparent" Cursor="Hand"
                        ToolTip="Start" AutomationProperties.Name="Mediacenter Start">
                    <Image Source="/Assets/logo.png" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel x:Name="NavItems" Grid.Column="1" Orientation="Horizontal" Margin="30,0,0,0"/>
                <StackPanel x:Name="NavTools" Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="ProfileNavButton" Style="{StaticResource IconButton}" Margin="0,0,4,0" VerticalAlignment="Center" ToolTip="Profil wechseln" AutomationProperties.Name="Profil wechseln"/>
                    <Button x:Name="SearchNavButton" Style="{StaticResource IconButton}" Content="&#xE721;" Margin="0,0,4,0" VerticalAlignment="Center" ToolTip="Suchen (Strg+F)" AutomationProperties.Name="Suche"/>
                    <StackPanel x:Name="UtilItems" Orientation="Horizontal"/>
                    <Button x:Name="FullscreenNavButton" Style="{StaticResource IconButton}" Content="&#xE740;" Margin="4,0,0,0" VerticalAlignment="Center" ToolTip="Vollbild (F11)" AutomationProperties.Name="Vollbild"/>
                    <Button x:Name="VersionButton" Style="{StaticResource VersionLink}" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="Changelog anzeigen" AutomationProperties.Name="Version und Changelog"/>
                </StackPanel>
            </Grid>
        </c:GlassPanel>

        <c:MiniPlayer x:Name="Mini" VerticalAlignment="Bottom"/>

        <!-- Fenster über der Seite (Browser, Umbenennen, Editor …) und Rückfragen darüber -->
        <c:ModalHost x:Name="Modal"/>
        </Grid>
        <c:ModalHost x:Name="Dialog" GlassLayer="Stage"/>

        <!-- Meldungen und Fortschritt unten -->
        <StackPanel x:Name="Toasts" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,26"/>

        <Border x:Name="PictureInPictureFrame" Background="#161616" Visibility="Collapsed"/>
        <p:PlayerView x:Name="PlayerLayer" Visibility="Collapsed"/>
    </Grid>
</Window>
