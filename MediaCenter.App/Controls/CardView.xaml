<UserControl x:Class="MediaCenter.App.Controls.CardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="176" Focusable="True" Cursor="Hand" FocusVisualStyle="{x:Null}">
    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="Poster" Height="264" CornerRadius="18" BorderThickness="2" BorderBrush="Transparent"
                Background="{DynamicResource CardBgBrush}" SnapsToDevicePixels="True">
            <Grid>
                <TextBlock x:Name="PlaceholderTitle" Style="{StaticResource DisplayText}" Foreground="White" FontSize="32"
                           TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="14,0,14,16" Visibility="Collapsed"/>
                <Border x:Name="OfflineChip" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"
                        CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}" Background="#CC000000" Padding="9,3">
                    <TextBlock Text="Offline" Foreground="White" FontSize="11" FontFamily="{StaticResource BodySemiFont}"/>
                </Border>
                <Border x:Name="ProgressTrack" Visibility="Collapsed" VerticalAlignment="Bottom" Height="4" Margin="12,0,12,12"
                        CornerRadius="2" Background="#66000000">
                    <Border x:Name="ProgressFill" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource AccentBrush}"/>
                </Border>
            </Grid>
        </Border>

        <TextBlock x:Name="TitleText" Grid.Row="1" Margin="2,10,2,0" FontFamily="{StaticResource BodySemiFont}" FontSize="15"
                   Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="MetaText" Grid.Row="2" Margin="2,2,2,0" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                   TextTrimming="CharacterEllipsis"/>
    </Grid>
</UserControl>
