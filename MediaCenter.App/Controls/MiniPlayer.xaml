<UserControl x:Class="MediaCenter.App.Controls.MiniPlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MediaCenter.App.Controls">
    <!-- Schwebende Glas-Insel (Liquid Glass): links Titel, in der Mitte Steuerung mit Zeitleiste, rechts Lautstärke -->
    <c:GlassPanel Height="72" Margin="24,0,24,16" Padding="0" CornerRadius="36">
        <Grid Margin="22,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="200"/>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="3*" MinWidth="180"/>
            </Grid.ColumnDefinitions>

            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="CoverBox" Width="48" Height="48" CornerRadius="12" Background="{DynamicResource CardBgBrush}">
                    <TextBlock x:Name="CoverGlyph" Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="22"
                               Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontFamily="{StaticResource BodySemiFont}" FontSize="14" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource InkBrush}"/>
                    <TextBlock x:Name="SubText" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="660">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="PrevButton" Style="{StaticResource IconButton}" Width="32" Height="32" Content="&#xE892;" ToolTip="Zurück" AutomationProperties.Name="Vorheriger Titel"/>
                    <Button x:Name="BackSkipButton" Style="{StaticResource IconButton}" Width="32" Height="32" Content="&#xED3C;" ToolTip="10 s zurück" AutomationProperties.Name="10 Sekunden zurück"/>
                    <Button x:Name="PlayPauseButton" Style="{StaticResource AccentIconButton}" Width="34" Height="34" FontSize="15" Content="&#xE769;" Margin="6,0" AutomationProperties.Name="Wiedergabe oder Pause"/>
                    <Button x:Name="ForwardSkipButton" Style="{StaticResource IconButton}" Width="32" Height="32" Content="&#xED3D;" ToolTip="30 s vor" AutomationProperties.Name="30 Sekunden vor"/>
                    <Button x:Name="NextButton" Style="{StaticResource IconButton}" Width="32" Height="32" Content="&#xE893;" ToolTip="Weiter" AutomationProperties.Name="Nächster Titel"/>
                </StackPanel>
                <Grid x:Name="SeekArea" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="34"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" MinWidth="34"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PositionText" Text="0:00" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/>
                    <Slider x:Name="SeekSlider" Grid.Column="1" Style="{StaticResource SeekSlider}" Margin="10,0" Minimum="0" Maximum="1"/>
                    <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                </Grid>
                <Border x:Name="LiveBadge" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,6,0,0"
                        CornerRadius="12" Background="{DynamicResource Accent2SoftBrush}" Padding="12,4">
                    <TextBlock Text="LIVE" FontFamily="{StaticResource BodySemiFont}" FontSize="12" Foreground="{DynamicResource Accent2Brush}"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="SoundButton" Style="{StaticResource IconButton}" Width="32" Height="32" Content="&#xE9E9;" ToolTip="Klang (Equalizer)" AutomationProperties.Name="Klang"/>
                <TextBlock x:Name="SleepText" FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="4,0,0,0" Visibility="Collapsed"/>
                <Button x:Name="SleepButton" Style="{StaticResource IconButton}" Width="32" Height="32" Content="&#xE708;" ToolTip="Einschlaf-Timer" AutomationProperties.Name="Einschlaf-Timer"/>
                <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Width="32" Height="32" Content="&#xE767;" ToolTip="Ton aus" AutomationProperties.Name="Stumm schalten"/>
                <Slider x:Name="VolumeSlider" Style="{StaticResource SeekSlider}" Width="100" Minimum="0" Maximum="100" Value="80" VerticalAlignment="Center"/>
                <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Width="32" Height="32" Content="&#xE711;" Margin="8,0,0,0" ToolTip="Wiedergabe beenden" AutomationProperties.Name="Wiedergabe beenden"/>
            </StackPanel>
        </Grid>
    </c:GlassPanel>
</UserControl>
