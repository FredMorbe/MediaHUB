<Window x:Class="MediaCenter.App.Player.PlayerOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        FontFamily="{StaticResource BodyFont}" TextElement.Foreground="White">
    <Window.Resources>
        <!-- Runde Glasknöpfe oben (Zurück, Bild-in-Bild, Vollbild) -->
        <Style x:Key="PlayerGlass" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="23" Background="#66000000" BorderBrush="#26FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#99FFFFFF"/><Setter Property="Foreground" Value="Black"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.75"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Symbolknopf der Leiste; Tag="on" zeigt einen Akzentpunkt (Timer läuft, Klang geändert, Übertragung aktiv) -->
        <Style x:Key="PlayerTool" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="21" Background="Transparent"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#2EFFFFFF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.6"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
                            <Trigger Property="Tag" Value="on"><Setter TargetName="Dot" Property="Visibility" Value="Visible"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Beschriftete Pille der Leiste (Ton, Untertitel, Intro, Einzelbild, Tempo) -->
        <Style x:Key="PlayerPill" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource BodySemiFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="18" Background="#26FFFFFF" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#47FFFFFF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.7"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- #01000000 statt Transparent: so fängt das Fenster Klicks auf das Video ab (Pause, Doppelklick = Vollbild). -->
    <Grid x:Name="Root" Background="#01000000">
        <!-- Beim Übertragen auf einen Fernseher steht hier statt des Videos der Zielname -->
        <StackPanel x:Name="CastBanner" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="72" Foreground="#80FFFFFF" HorizontalAlignment="Center"/>
            <TextBlock x:Name="CastBannerTitle" FontFamily="{StaticResource DisplayFont}" FontSize="38" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            <TextBlock x:Name="CastBannerText" FontSize="15" Foreground="#B0FFFFFF" HorizontalAlignment="Center" Margin="0,4,0,0" Text="Wird auf diesem Fernseher abgespielt"/>
        </StackPanel>
        <!-- Kurzes Zeichen bei Wiedergabe / Pause -->
        <Border x:Name="StateFlash" Width="104" Height="104" CornerRadius="52" Background="#99000000" HorizontalAlignment="Center" VerticalAlignment="Center"
                IsHitTestVisible="False" Opacity="0">
            <TextBlock x:Name="StateFlashGlyph" FontFamily="{StaticResource IconFont}" FontSize="40" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <Grid x:Name="Controls">
            <!-- Oben: Verlauf nach unten, links Zurück und Titel, rechts Fenster-Werkzeuge -->
            <Border VerticalAlignment="Top" Height="190" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#CC000000" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Grid VerticalAlignment="Top" Margin="28,24,28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Style="{StaticResource PlayerGlass}" Content="&#xE72B;" ToolTip="Zurück (Esc)" AutomationProperties.Name="Zurück" VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1" Margin="18,0,18,0" VerticalAlignment="Center">
                    <TextBlock x:Name="KickerText" FontFamily="{StaticResource BodySemiFont}" FontSize="12" Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                    <TextBlock x:Name="TitleText" FontFamily="{StaticResource DisplayFont}" FontSize="38" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="StatsText" FontSize="12" Foreground="#B0FFFFFF" Visibility="Collapsed" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="PictureInPictureButton" Style="{StaticResource PlayerGlass}" Content="&#xE8A7;" Margin="0,0,10,0" ToolTip="Schwebender Player (P)" AutomationProperties.Name="Bild-in-Bild aktivieren"/>
                    <Button x:Name="FullscreenButton" Style="{StaticResource PlayerGlass}" Content="&#xE740;" ToolTip="Vollbild (F)" AutomationProperties.Name="Vollbild"/>
                </StackPanel>
            </Grid>

            <!-- Unten: schwebende Leiste mit Zeitleiste, Wiedergabe links und Werkzeugen rechts -->
            <Border x:Name="Dock" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" MaxWidth="1600" Margin="28,0,28,24"
                    CornerRadius="26" Background="#E60A0F1A" BorderBrush="#26FFFFFF" BorderThickness="1" Padding="24,14,24,14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="44" ShadowDepth="0" Opacity="0.55" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="ChapterText" FontSize="12" Foreground="#B0FFFFFF" Visibility="Collapsed" Margin="0,0,0,2" TextTrimming="CharacterEllipsis"/>
                    <Grid x:Name="SeekRow">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PositionText" Text="0:00:00" VerticalAlignment="Center" FontSize="13" FontFamily="{StaticResource BodySemiFont}" MinWidth="52"/>
                        <Grid Grid.Column="1" Margin="14,0">
                            <Slider x:Name="SeekSlider" Style="{StaticResource SeekSlider}" Background="#40FFFFFF" Minimum="0" Maximum="1"/>
                            <!-- Kapitelstriche auf der Zeitleiste -->
                            <Canvas x:Name="ChapterMarks" Height="22" IsHitTestVisible="False" VerticalAlignment="Center"/>
                            <!-- Zeit unter dem Mauszeiger -->
                            <Border x:Name="SeekTip" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,-40,0,0"
                                    CornerRadius="10" Background="#F2000000" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="10,5">
                                <TextBlock x:Name="SeekTipText" FontSize="12" FontFamily="{StaticResource BodySemiFont}" Foreground="White"/>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00:00" VerticalAlignment="Center" FontSize="13" Foreground="#B0FFFFFF" MinWidth="52" TextAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button x:Name="BackButton10" Style="{StaticResource PlayerTool}" Content="&#xED3C;" ToolTip="10 s zurück" AutomationProperties.Name="10 Sekunden zurück"/>
                            <Button x:Name="ChannelPrevButton" Style="{StaticResource PlayerTool}" Content="&#xE892;" Visibility="Collapsed" ToolTip="Voriger Sender (Bild auf)" AutomationProperties.Name="Voriger Sender"/>
                            <Button x:Name="PlayPauseButton" Style="{StaticResource AccentIconButton}" Content="&#xE769;" FontSize="20" Width="54" Height="54" Margin="6,0" ToolTip="Wiedergabe / Pause (Leertaste)" AutomationProperties.Name="Wiedergabe oder Pause"/>
                            <Button x:Name="ForwardButton" Style="{StaticResource PlayerTool}" Content="&#xED3D;" ToolTip="30 s vor" AutomationProperties.Name="30 Sekunden vor"/>
                            <Button x:Name="NextButton" Style="{StaticResource PlayerTool}" Content="&#xE893;" Visibility="Collapsed" AutomationProperties.Name="Nächste Folge"/>
                            <Button x:Name="IntroSkipButton" Style="{StaticResource PlayerPill}" Content="Intro" Margin="10,0,0,0" ToolTip="Intro überspringen: Ende des Vorspann-Kapitels, sonst 85 Sekunden vor (S)" AutomationProperties.Name="Intro überspringen"/>
                            <Button x:Name="MuteButton" Style="{StaticResource PlayerTool}" Content="&#xE767;" Margin="16,0,0,0" ToolTip="Ton aus (M)" AutomationProperties.Name="Stumm schalten"/>
                            <Slider x:Name="VolumeSlider" Style="{StaticResource SeekSlider}" Background="#40FFFFFF" Width="88" Minimum="0" Maximum="100" Value="100" VerticalAlignment="Center"/>
                            <!-- Einzelbild nur bei Pause; Tempo nur, wenn es nicht 1× ist -->
                            <Button x:Name="FramePrevButton" Style="{StaticResource PlayerPill}" Content="−1 Bild" Margin="14,0,0,0" Visibility="Collapsed" ToolTip="Ein Bild zurück (Strg+←, Komma)" AutomationProperties.Name="Ein Bild zurück"/>
                            <Button x:Name="FrameNextButton" Style="{StaticResource PlayerPill}" Content="+1 Bild" Margin="6,0,0,0" Visibility="Collapsed" ToolTip="Ein Bild vor (Strg+→, Punkt)" AutomationProperties.Name="Ein Bild vor"/>
                            <Button x:Name="SpeedButton" Style="{StaticResource PlayerPill}" Content="1×" Margin="10,0,0,0" Visibility="Collapsed" ToolTip="Normale Geschwindigkeit (Strg+R)" AutomationProperties.Name="Geschwindigkeit zurücksetzen"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="AudioButton" Style="{StaticResource PlayerPill}" Content="Ton" Margin="0,0,8,0" ToolTip="Tonspur wählen" AutomationProperties.Name="Ton"/>
                            <Button x:Name="SubButton" Style="{StaticResource PlayerPill}" Content="Untertitel" Margin="0,0,14,0" ToolTip="Untertitel wählen, laden, suchen, übersetzen" AutomationProperties.Name="Untertitel"/>
                            <Border Width="1" Height="24" Background="#26FFFFFF" Margin="0,0,10,0"/>
                            <Button x:Name="ChaptersButton" Style="{StaticResource PlayerTool}" Content="&#xE7C1;" Visibility="Collapsed" ToolTip="Kapitel (Bild auf / Bild ab: voriges / nächstes)" AutomationProperties.Name="Kapitel"/>
                            <Button x:Name="EpisodesButton" Style="{StaticResource PlayerTool}" Content="&#xE8FD;" Visibility="Collapsed" ToolTip="Folge der Serie wählen" AutomationProperties.Name="Folgen"/>
                            <Button x:Name="AdjustButton" Style="{StaticResource PlayerTool}" Content="&#xE8D2;" ToolTip="Untertitel anpassen: Zeitversatz, Größe, Position (Z / X = 0,1 s früher / später)" AutomationProperties.Name="Untertitel anpassen"/>
                            <Button x:Name="PictureButton" Style="{StaticResource PlayerTool}" Content="&#xE8B9;" ToolTip="Bild: Seitenverhältnis, Tempo, Zoom, Drehen" AutomationProperties.Name="Bildoptionen"/>
                            <Button x:Name="ColorButton" Style="{StaticResource PlayerTool}" Content="&#xE790;" ToolTip="Farbe: LUT, Helligkeit, Kontrast, Sättigung, Weißabgleich, Invertieren" AutomationProperties.Name="Farbeinstellungen"/>
                            <Button x:Name="CastButton" Style="{StaticResource PlayerTool}" Content="&#xE7F4;" ToolTip="Auf einen Fernseher übertragen (Google Cast)" AutomationProperties.Name="Übertragen"/>
                            <Button x:Name="SleepButton" Style="{StaticResource PlayerTool}" Content="&#xE708;" ToolTip="Einschlaf-Timer" AutomationProperties.Name="Einschlaf-Timer"/>
                            <Button x:Name="SoundButton" Style="{StaticResource PlayerTool}" Content="&#xE9E9;" ToolTip="Klang: Equalizer-Voreinstellungen" AutomationProperties.Name="Klang"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Spurauswahl über der Leiste, rechts -->
            <Border x:Name="TrackMenu" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,28,176"
                    CornerRadius="18" Background="#F20B1220" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="8" MinWidth="220" MaxHeight="320">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TrackList"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Kompakte Bedienung im schwebenden Fenster. Die freien Fensterränder bleiben zum Skalieren erreichbar. -->
        <Grid x:Name="CompactControls" Visibility="Collapsed">
            <Border x:Name="CompactHeader" VerticalAlignment="Top" Background="#B0000000" Padding="10,4" Cursor="SizeAll">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="RestorePlayerButton" Style="{StaticResource IconButton}" Width="32" Height="32" Foreground="White" Content="&#xE73F;" ToolTip="Zurück zum großen Player (P / Esc)" AutomationProperties.Name="Bild-in-Bild beenden"/>
                        <Button x:Name="CloseCompactButton" Style="{StaticResource IconButton}" Width="32" Height="32" Foreground="White" Content="&#xE711;" ToolTip="Wiedergabe beenden" AutomationProperties.Name="Wiedergabe beenden"/>
                    </StackPanel>
                    <TextBlock x:Name="CompactTitle" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                </DockPanel>
            </Border>
            <Border VerticalAlignment="Bottom" Background="#B0000000" Padding="10,4">
                <StackPanel>
                    <DockPanel x:Name="CompactNext" Visibility="Collapsed" Margin="0,0,0,4">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="CompactNextNow" Style="{StaticResource GhostButton}" Foreground="White" Content="Jetzt" Padding="8,4" AutomationProperties.Name="Nächste Folge jetzt abspielen"/>
                            <Button x:Name="CompactNextCancel" Style="{StaticResource IconButton}" Foreground="White" Content="&#xE711;" Width="28" Height="28" ToolTip="Automatischen Start abbrechen" AutomationProperties.Name="Automatischen Start abbrechen"/>
                        </StackPanel>
                        <TextBlock x:Name="CompactNextHint" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <DockPanel>
                        <Button x:Name="CompactPlayPause" DockPanel.Dock="Left" Style="{StaticResource IconButton}" Foreground="White" Width="32" Height="32" Content="&#xE769;" ToolTip="Wiedergabe / Pause (Leertaste)" AutomationProperties.Name="Wiedergabe oder Pause"/>
                        <Button x:Name="CompactMute" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Foreground="White" Width="32" Height="32" Content="&#xE767;" ToolTip="Ton aus / an (M)" AutomationProperties.Name="Stumm schalten"/>
                        <TextBlock x:Name="CompactTime" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Untertitel anpassen: Zeitversatz, Größe, Höhe (Inhalt entsteht im Code) -->
        <Border x:Name="AdjustPanel" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,28,176"
                CornerRadius="16" Background="#F00B1220" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="18,14,10,14" MinWidth="380">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="AdjustContent" Margin="0,0,8,0"/>
            </ScrollViewer>
        </Border>

        <!-- Bild: Seitenverhältnis, Tempo, Zoom und Ausschnitt, Drehen (Inhalt entsteht im Code) -->
        <Border x:Name="PicturePanel" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,28,176"
                CornerRadius="16" Background="#F00B1220" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="18,14,10,14" Width="480">
            <ScrollViewer x:Name="PictureScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PictureContent" Margin="0,0,8,0"/>
            </ScrollViewer>
        </Border>

        <!-- Farbe: Helligkeit, Kontrast, Sättigung, Farbton, Gamma, Weißabgleich, Schärfe, Invertieren (Inhalt entsteht im Code) -->
        <Border x:Name="ColorPanel" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,28,176"
                CornerRadius="16" Background="#F00B1220" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="18,14,10,14" Width="480">
            <ScrollViewer x:Name="ColorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ColorContent" Margin="0,0,8,0"/>
            </ScrollViewer>
        </Border>

        <!-- Untertitel übersetzen: Quelle und Zielsprachen wählen, Fortschritt (Inhalt entsteht im Code) -->
        <Border x:Name="TranslatePanel" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,28,176"
                CornerRadius="16" Background="#F00B1220" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="18,14" MinWidth="400" MaxWidth="520">
            <StackPanel x:Name="TranslateContent"/>
        </Border>

        <!-- Untertitel online suchen: Trefferliste (Inhalt entsteht im Code) -->
        <Border x:Name="SearchPanel" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,28,176"
                CornerRadius="18" Background="#F20B1220" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="20,16" MinWidth="440" MaxWidth="600">
            <StackPanel x:Name="SearchContent"/>
        </Border>

        <!-- Arbeit im Gang (Einbetten): sperrt die Bedienung darunter -->
        <Grid x:Name="BusyLayer" Visibility="Collapsed" Background="#B0000000">
            <Border VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="18" Background="#F50B1220" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="30,26" MinWidth="460" MaxWidth="620">
                <StackPanel>
                    <TextBlock x:Name="BusyTitle" FontFamily="{StaticResource DisplayFont}" FontSize="28"/>
                    <TextBlock x:Name="BusyText" FontSize="14" Foreground="#B0FFFFFF" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <ProgressBar x:Name="BusyBar" Minimum="0" Maximum="1" Height="6" Margin="0,18,0,18" BorderThickness="0"/>
                    <Button x:Name="BusyCancelButton" Style="{StaticResource GhostButton}" Foreground="White" Content="Abbrechen" Padding="18,8" HorizontalAlignment="Left" AutomationProperties.Name="Einbetten abbrechen"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Kurzer Hinweis oben mittig (Toasts des Hauptfensters liegen unter dem Video) -->
        <Border x:Name="Notice" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,70,0,0"
                CornerRadius="14" Background="#EE0B1220" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="18,10">
            <TextBlock x:Name="NoticeText" FontSize="15" TextWrapping="Wrap" MaxWidth="640"/>
        </Border>

        <!-- Intro überspringen: erscheint, solange ein Vorspann-Kapitel läuft, auch bei ausgeblendeter Steuerung -->
        <Border x:Name="IntroCard" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,28,176"
                CornerRadius="18" Background="#F20B1220" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="10">
            <Button x:Name="IntroCardButton" Style="{StaticResource PrimaryButton}" Content="Intro überspringen" Padding="20,9" AutomationProperties.Name="Intro überspringen jetzt"/>
        </Border>

        <!-- Nächste Folge: bleibt auch bei ausgeblendeter Steuerung sichtbar, solange der Countdown läuft -->
        <Border x:Name="NextCard" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,28,176"
                CornerRadius="16" Background="#F00B1220" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="20,16" MinWidth="300">
            <StackPanel>
                <TextBlock x:Name="NextHint" FontSize="13" Foreground="#B0FFFFFF"/>
                <TextBlock x:Name="NextTitle" FontFamily="{StaticResource DisplayFont}" FontSize="26" Margin="0,2,0,12" TextWrapping="Wrap" MaxWidth="360"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="NextNowButton" Style="{StaticResource PrimaryButton}" Content="Jetzt abspielen" Padding="18,8" Margin="0,0,8,0" AutomationProperties.Name="Nächste Folge jetzt abspielen"/>
                    <Button x:Name="NextCancelButton" Style="{StaticResource GhostButton}" Foreground="White" Content="Abbrechen" Padding="18,8" AutomationProperties.Name="Automatischen Start abbrechen"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
