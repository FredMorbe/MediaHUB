<?xml version="1.0" encoding="utf-8"?>
<!-- Dev-Build: eigenständiger Ordner für Windows x64, die .NET-Laufzeit liegt dabei (keine Installation nötig).
     Aufruf: dotnet publish MediaCenter.App -p:PublishProfile=Dev   (oder publish-dev.ps1 im Hauptordner)
     mpv, ffmpeg und ffprobe liegen nicht bei: Sie gehören in den Unterordner tools neben MediaCenter.exe (siehe MediaCenter.Core\ToolLocator.cs). -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishDir>..\..\dist\MediaCenter-dev\</PublishDir>
  </PropertyGroup>
</Project>
