<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041 gibt Zugriff auf die Windows-Mediensteuerung (Medientasten, Lautstärke-Anzeige) -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MediaCenter</AssemblyName>
    <RootNamespace>MediaCenter.App</RootNamespace>
    <!-- Die Version der App; bei jeder neuen Version auch einen Eintrag in Services\Changelog.cs anlegen. -->
    <Version>0.12.0</Version>
    <!-- Erzeugt von Assets\make_icon.py -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MediaCenter.Core\MediaCenter.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Fonts\*.ttf" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <!-- Google Cast: Geräte im Netz finden und den Fernseher steuern -->
    <PackageReference Include="Sharpcaster" Version="3.0.0" />
  </ItemGroup>

</Project>
