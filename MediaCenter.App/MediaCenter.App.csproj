    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MediaCenter</AssemblyName>
    <RootNamespace>MediaCenter.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MediaCenter.Core\MediaCenter.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Fonts\*.ttf" />
  </ItemGroup>

</Project>
